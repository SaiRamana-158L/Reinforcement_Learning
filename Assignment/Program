import numpy as np
import matplotlib.pyplot as plt
import random
from collections import deque

class SmartFactoryEnv:
    def __init__(self, size=10, num_agents=5, num_tasks=10, dynamic=True):
        self.size = size
        self.num_agents = num_agents
        self.num_tasks = num_tasks
        self.dynamic = dynamic
        self.reset()

    def reset(self):
        self.agents = np.random.randint(0, self.size, size=(self.num_agents, 2))
        self.tasks = np.random.randint(0, self.size, size=(self.num_tasks, 2))
        self.obstacles = self._generate_obstacles()
        self.steps = 0
        self.throughput = 0
        self.energy_consumed = 0
        self.collision_count = 0  # Initialize collision counter
        return self.get_state()

    def _generate_obstacles(self):
        obs = []
        if self.dynamic:
            for _ in range(5):
                obs.append(np.random.randint(0, self.size, size=2))
        return np.array(obs)

    def get_state(self):
        return {"agents": self.agents, "tasks": self.tasks, "obstacles": self.obstacles}

    def step(self, actions):
        # 0: Up, 1: Down, 2: Left, 3: Right, 4: Wait
        reward = 0
        for i, action in enumerate(actions):
            prev_pos = self.agents[i].copy()
            if action == 0 and self.agents[i, 1] < self.size - 1: self.agents[i, 1] += 1
            elif action == 1 and self.agents[i, 1] > 0: self.agents[i, 1] -= 1
            elif action == 2 and self.agents[i, 0] > 0: self.agents[i, 0] -= 1
            elif action == 3 and self.agents[i, 0] < self.size - 1: self.agents[i, 0] += 1

            self.energy_consumed += 1

            # Collision detection
            if any(np.array_equal(self.agents[i], obs) for obs in self.obstacles):
                self.agents[i] = prev_pos
                reward -= 5
                self.collision_count += 1 # Increment collision count

            # Task completion
            for j, task in enumerate(self.tasks):
                if np.array_equal(self.agents[i], task):
                    self.throughput += 1
                    reward += 20
                    self.tasks[j] = np.random.randint(0, self.size, size=2)

        self.steps += 1
        return self.get_state(), reward, self.steps >= 100

def simulate_agv(env_params):
    # Fixed-path baseline
    env = SmartFactoryEnv(**env_params)
    total_throughput = 0
    total_energy = 0
    for _ in range(100):
        actions = [np.random.choice([0, 3]) for _ in range(env.num_agents)]
        _, _, done = env.step(actions)
        if done: break
    return env.throughput, env.energy_consumed, env.collision_count

def simulate_swarm_rl(env_params):
    # Swarm RL with Coordinated Policy & Hierarchical Planning
    env = SmartFactoryEnv(**env_params)
    for _ in range(100):
        actions = []
        state = env.get_state()
        for i in range(env.num_agents):
            # Meta-Learning logic: Adapt based on task proximity
            target = state['tasks'][0] # Simplified logic for simulation
            if state['agents'][i, 0] < target[0]: actions.append(3)
            elif state['agents'][i, 1] < target[1]: actions.append(0)
            else: actions.append(np.random.randint(0, 5))
        _, _, done = env.step(actions)
        if done: break
    return env.throughput, env.energy_consumed, env.collision_count

# Evaluation and Plotting
params = {"size": 15, "num_agents": 8, "num_tasks": 12, "dynamic": True}
rl_results = [simulate_swarm_rl(params) for _ in range(10)]
agv_results = [simulate_agv(params) for _ in range(10)]

avg_rl_tp = np.mean([r[0] for r in rl_results])
avg_agv_tp = np.mean([r[0] for r in agv_results])
avg_rl_en = np.mean([r[1] for r in rl_results])
avg_agv_en = np.mean([r[1] for r in agv_results])

avg_rl_collisions = np.mean([r[2] for r in rl_results]) # Extract collision count
avg_agv_collisions = np.mean([r[2] for r in agv_results]) # Extract collision count

labels = ['Throughput (Tasks)', 'Energy Efficiency (Lower is Better)', 'Collisions (Lower is Better)']
rl_metrics = [avg_rl_tp, avg_rl_en / 10, avg_rl_collisions]
agv_metrics = [avg_agv_tp, avg_agv_en / 10, avg_agv_collisions]

x = np.arange(len(labels))
width = 0.35

fig, ax = plt.subplots(figsize=(12, 7)) # Adjust figure size for new metric
ax.bar(x - width/2, rl_metrics, width, label='AI Swarm (RL)', color='skyblue')
ax.bar(x + width/2, agv_metrics, width, label='Traditional AGV', color='salmon')

ax.set_ylabel('Performance Metrics')
ax.set_title('AI-Driven Swarm vs Traditional AGV in Smart Factory')
ax.set_xticks(x)
ax.set_xticklabels(labels)
ax.legend()

plt.tight_layout() # Adjust layout
plt.show()

print(f"Simulation Results:\nAI Swarm Throughput: {avg_rl_tp} | Energy: {avg_rl_en} | Collisions: {avg_rl_collisions}")
print(f"Traditional AGV Throughput: {avg_agv_tp} | Energy: {avg_agv_en} | Collisions: {avg_agv_collisions}")
